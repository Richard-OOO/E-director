# Gateway auth
MYSQL_DSN=root:<your-mysql-password>@tcp(127.0.0.1:3306)/e_director?parseTime=true
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
GATEWAY_ADDR=:8080
HTTP_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost
FRONTEND_ORIGIN=http://localhost
SESSION_COOKIE_NAME=e_director_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
VERIFICATION_TTL_SECONDS=300
CODE_COOLDOWN_SECONDS=60
CODE_MAX_ATTEMPTS=5
CODE_ATTEMPT_TTL_SECONDS=900
TOKEN_SECRET=change-me
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=your@qq.com
SMTP_PASSWORD=<qq-mail-app-password>
SMTP_FROM=your@qq.com

# Docker Compose deployment
NGINX_PORT=80
MYSQL_DATABASE=e_director
MYSQL_USER=e_director
MYSQL_PASSWORD=e_director
MYSQL_ROOT_PASSWORD=root

# OpenAI-compatible / DashScope LLM
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
DASHSCOPE_API_KEY=
OPENAI_MODEL=qwen-flash-2025-07-28
OPENAI_MAX_TOKENS=10000

# Anthropic / LLM worker placeholder
ANTHROPIC_API_KEY=

# Optional local proxy. With Docker Desktop on Windows, containers usually
# reach the host machine through host.docker.internal.
HTTP_PROXY=http://host.docker.internal:7879
HTTPS_PROXY=http://host.docker.internal:7879

# Internal service calls should not go through the proxy.
NO_PROXY=localhost,127.0.0.1,redis,gateway,web,nginx,ai-worker
